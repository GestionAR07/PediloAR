# Marketplace Rawson — environment variables (example)
#
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local
#
# Never commit `.env.local` or real secrets.

# -----------------------------------------------------------------------------
# Database (server-only) — Drizzle / postgres.js
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler or direct).
# Used by Drizzle migrate and server-side getDb() only.
# NEVER expose as NEXT_PUBLIC_*.
#
# Example shape (replace with your dev project values; do not commit real secrets):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Auth (browser + server via publishable key)
# -----------------------------------------------------------------------------
# Project URL and publishable (anon) key from Supabase Dashboard → Settings → API.
# These are safe to ship to the browser. Never put secret/service keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NOT used in Phase 3A (no admin client / invite API yet):
# SUPABASE_SECRET_KEY=
