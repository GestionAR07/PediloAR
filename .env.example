# Marketplace Rawson — environment variables (example)
#
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local
#
# Never commit `.env.local` or real secrets.

# -----------------------------------------------------------------------------
# App public origin (server-side) — invitations and auth redirects
# -----------------------------------------------------------------------------
# Absolute origin of this Next.js app. Used when building invite links.
# Local development for this project often uses port 3001 (3000 may be taken):
#   APP_BASE_URL=http://localhost:3001
# Production should use https://…
APP_BASE_URL=

# -----------------------------------------------------------------------------
# Database (server-only) — Drizzle / postgres.js
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler or direct).
# Used by Drizzle migrate and server-side getDb() only.
# NEVER expose as NEXT_PUBLIC_*.
#
# Example shape (replace with your dev project values; do not commit real secrets):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Auth (browser + server via publishable key)
# -----------------------------------------------------------------------------
# Project URL and publishable (anon) key from Supabase Dashboard → Settings → API.
# These are safe to ship to the browser. Never put secret/service keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase secret key (server-only) — Auth Admin API
# -----------------------------------------------------------------------------
# Used exclusively for server-side Auth Admin operations (locate users, invite).
# NEVER expose as NEXT_PUBLIC_SUPABASE_SECRET_KEY.
# NEVER import/use this in Client Components.
# Real value lives only in .env.local / secure hosting secrets.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Real order-lifecycle harness (manual DEV smoke only)
# -----------------------------------------------------------------------------
# Exact Supabase project ref of the authorized DEV project
# (the subdomain of https://<ref>.supabase.co).
# Required by scripts/validate-real-order-lifecycle.ts. No fallback.
# Never commit the real value.
MARKETPLACE_DEV_PROJECT_REF=
