# Marketplace Rawson — environment variables (example)
#
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local
#
# Never commit `.env.local` or real secrets.

# -----------------------------------------------------------------------------
# Database (server-only) — Phase 2B+
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase pooler or direct).
# Used by Drizzle migrate and server-side getDb() only.
# NEVER expose as NEXT_PUBLIC_*.
#
# Example shape (replace with your dev project values; do not commit real secrets):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional local non-Supabase Postgres for integration experiments:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/marketplace_rawson_dev

# -----------------------------------------------------------------------------
# Auth / Supabase client keys — NOT used in Phase 2B
# -----------------------------------------------------------------------------
# Will be documented when Auth is implemented (Phase 3+). Do not add public DB access.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
