# Marketplace Rawson — environment variables (example)
#
# Copy this file to `.env.local` for local development:
#   copy .env.example .env.local
#
# Never commit `.env.local` or real secrets.
#
# Phase 1 (current): no runtime env vars required.
# Phase 2+: Supabase and other integrations will document
# their variables here (e.g. NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY).

# Placeholder so tooling recognizes this as an env template.
# Uncomment and set when Phase 2 begins:
# NEXT_PUBLIC_APP_ENV=development
